# Этап 1: сборка
FROM node:20-alpine AS build

WORKDIR /app

COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --network-timeout 600000

COPY . .

# По умолчанию API на том же домене по /api (nginx проксирует на бэкенд)
ARG REACT_APP_BACKEND_URL=/api
ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL
ARG REACT_APP_ENV=test
ENV REACT_APP_ENV=$REACT_APP_ENV
ENV GENERATE_SOURCEMAP=false

RUN yarn build

# Этап 2: раздача статики через nginx
FROM nginx:stable-alpine

# Адрес бэкенда (host:port); переопределяется переменной окружения контейнера
ENV BACKEND_UPSTREAM=bp-scanner-test:80

COPY --from=build /app/build /usr/share/nginx/html
COPY nginx/default.conf.template /etc/nginx/templates/default.conf.template

EXPOSE 80
