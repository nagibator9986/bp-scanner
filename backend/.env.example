# ===== База данных =====
MONGO_URL=mongodb://localhost:27017
DB_NAME=bp_scanner

# ===== Безопасность =====
# Обязательно задайте длинную случайную строку (одинаковую для всех реплик)
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=168
# Администратор создаётся при первом запуске
ADMIN_EMAIL=admin@bpscanner.ru
ADMIN_PASSWORD=change-me
# true — сбросить пароль существующего администратора на ADMIN_PASSWORD при старте
RESET_ADMIN_PASSWORD=false
# false — отключить самостоятельную регистрацию пользователей
ALLOW_REGISTRATION=true
# Через запятую; * — любые источники
CORS_ORIGINS=*

# ===== LLM (OpenAI-совместимый API, например внутренний Qwen за vLLM) =====
# Используются, пока администратор не сохранил настройки в интерфейсе («Настройки AI»)
LLM_PROVIDER=custom
LLM_BASE_URL=http://qwen.internal:8000/v1
LLM_MODEL=Qwen/Qwen3-32B
LLM_API_KEY=
# Лимит токенов ответа (пусто — по умолчанию сервера модели)
LLM_MAX_TOKENS=
LLM_TEMPERATURE=0.2
# true — отключить режим рассуждений Qwen3 (chat_template_kwargs.enable_thinking=false)
LLM_DISABLE_THINKING=false
# true — response_format=json_object (если сервер поддерживает guided decoding)
LLM_JSON_MODE=false
# Сколько запросов к модели выполняется одновременно
LLM_MAX_CONCURRENCY=2

# ===== Анализ =====
# Тайм-аут одного запроса к модели, сек
AI_STEP_TIMEOUT=600
# Попыток на запрос (повторы при сетевых ошибках и 5xx)
AI_MAX_ATTEMPTS=3
# Сколько символов из документов подразделения отправлять в модель (под контекст модели)
MAX_DOCUMENT_CHARS=30000
# Через сколько секунд без «пульса» анализ считается прерванным
ANALYSIS_STALE_SECONDS=180

# ===== Файлы =====
MAX_UPLOAD_MB=25
# UPLOAD_DIR=/app/app/uploads
